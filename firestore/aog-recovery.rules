// Fragment for the named Firestore database `appusers`.
// Merge these matches into the existing ruleset. Do not deploy this file
// by itself — it is not a complete ruleset and would lock every other
// collection. The Admin SDK (inbox scan, Stripe webhook, public election,
// gift, settings) bypasses these rules. Browsers may only read.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isOpsOrAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['ops', 'admin']
        && userDoc().active != false
        && userDoc().approved == true;
    }

    // Coverage rows. Ops reads them in the AOG Coverage tab. All writes
    // (premium, payment, signature, contracts) are server-side.
    match /aogRecovery/{coverageId} {
      allow read: if isOpsOrAdmin();
      allow create, update, delete: if false;
    }

    // Rate table and complimentary domains. The tab reads them; saves go
    // through /api/aog-recovery-settings.
    match /aogRecoveryConfig/{docId} {
      allow read: if isOpsOrAdmin();
      allow create, update, delete: if false;
    }

    // Graph message ids already handled. Not visible to browsers.
    match /aogRecoveryProcessed/{messageHash} {
      allow read, write: if false;
    }
  }
}
