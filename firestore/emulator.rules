// Open rules for the local Firebase emulator only.
// Do not deploy this file. Production rules are a separate ruleset;
// firestore/aog-recovery.rules is the fragment to merge there.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
